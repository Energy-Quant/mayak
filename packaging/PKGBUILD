package() {
    install -Dm755 "/home/quant/pantheon/packaging/pantheon-ui" "${pkgdir}/usr/bin/pantheon-ui"
    install -Dm644 "/home/quant/pantheon/packaging/pantheon-ui.desktop" "${pkgdir}/usr/share/applications/pantheon-ui.desktop"
    install -Dm644 "/home/quant/pantheon/packaging/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/pantheon-ui.png"
