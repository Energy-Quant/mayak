{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "developer__write|developer__edit|developer__shell",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/guard.sh",
            "timeout": 10,
            "on_failure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
