{
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
      "timeout": 10
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "developer__write|developer__edit|developer__shell",
    "hooks": [
     {
      "type": "command",
      "command": "${PLUGIN_ROOT}/scripts/guard-run.sh",
      "timeout": 10,
      "on_failure": "block"
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "${PLUGIN_ROOT}/scripts/escalate.sh",
      "timeout": 5
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
      "timeout": 5
     }
    ]
   }
  ],
  "SessionEnd": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "${PLUGIN_ROOT}/scripts/pantheon-log.sh",
      "timeout": 10
     }
    ]
   }
  ]
 }
}